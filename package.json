{
  "name": "mindful-canvas",
  "version": "2.0.0",
  "description": "Mindful Canvas — 覺知畫布 PWA（零依賴運行時；npm 僅用於開發與測試）",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "sw.js",
  "scripts": {
    "dev": "python3 -m http.server 8888",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run lint && npm run test && npm run test:e2e",
    "validate": "npm run format:check && npm run lint && npm run test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lt1634/mindful-canvas.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lt1634/mindful-canvas/issues"
  },
  "homepage": "https://github.com/lt1634/mindful-canvas#readme",
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.52.0",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.28.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "vitest": "^3.2.1"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
